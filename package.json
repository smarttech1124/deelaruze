{
  "name": "deelaruze-website",
  "version": "1.0.0",
  "description": "Independent street art publishing platform",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "nodemon server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/server.js",
    "seed:content": "node server/utils/seedContent.js",
    "format": "prettier --write \"src/**/*.{js,jsx,css,md}\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@shopify/shopify-api": "^12.3.0",
    "@stripe/react-stripe-js": "^2.4.0",
    "@stripe/stripe-js": "^2.4.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.309.0",
    "mongoose": "^8.0.4",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.9.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-phone-number-input": "^3.4.16",
    "react-router-dom": "^6.21.0",
    "stripe": "^14.11.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.6",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.11"
  },
  "keywords": [
    "street-art",
    "graffiti",
    "independent-publishing",
    "art-platform",
    "underground-culture"
  ],
  "author": "Deelaruze",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
